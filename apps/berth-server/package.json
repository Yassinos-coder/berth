{
  "name": "@berth/server",
  "version": "0.18.0",
  "private": true,
  "description": "Berth control plane - NestJS API.",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "prisma db execute --file prisma/pad-migration-names.sql && prisma migrate deploy",
    "predev": "prisma generate && bun run migrate",
    "prestart": "prisma generate && bun run migrate",
    "predeploy": "prisma generate && bun run migrate",
    "prisma:generate": "prisma generate",
    "db:push": "dotenv -e ../../.env -- prisma db push",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:seed": "dotenv -e ../../.env -- prisma db seed",
    "db:studio": "dotenv -e ../../.env -- prisma studio",
    "secrets:rotate": "dotenv -e ../../.env -- tsx scripts/rotate-secrets.ts",
    "dev:local": "dotenv -e ../../.env -- tsx scripts/dev-local.ts"
  },
  "dependencies": {
    "@berth/protocol": "workspace:*",
    "@nestjs/common": "^12.5.1",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.5.1",
    "@nestjs/jwt": "^12.0.5",
    "@nestjs/platform-express": "^12.5.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "^0.45.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.10",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "nestjs-shield": "^1.3.2",
    "node-forge": "^1.4.0",
    "nodemailer": "^10.6.0",
    "otplib": "^13.6.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.13",
    "@nestjs/schematics": "^12.0.13",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.13.1",
    "@types/node-forge": "^1.3.14",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.5",
    "@types/ws": "^8.18.2",
    "dotenv-cli": "^11.1.0",
    "prisma": "7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6",
    "vitest": "^5.1.0"
  }
}
